{
  "name": "@snapscript/table",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "exports": {
    "./project": "./src/project.ts",
    "./kit": "./src/kit.ts"
  },
  "scripts": {
    "build:app": "electron-vite build",
    "table": "pnpm --filter \"@snapscript/table^...\" --filter \"confetti^...\" build && electron-vite build && node src/start.ts",
    "smoke": "node test/smoke/smoke.ts",
    "lock": "pnpm --filter \"@snapscript/table^...\" build && node src/lock.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@snapscript/checker": "workspace:*",
    "@snapscript/core": "workspace:*",
    "@snapscript/faces": "workspace:*",
    "@snapscript/parser": "workspace:*",
    "@snapscript/runtime": "workspace:*",
    "@snapscript/table-reader": "workspace:*",
    "@types/mdast": "^4.0.4",
    "mdast-util-from-markdown": "^2.1.0",
    "p5": "^2.3.4",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "45.2.1",
    "electron-vite": "^6.0.0",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vitest": "catalog:"
  }
}
